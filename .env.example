# Local Docker Compose settings (replace before use; never commit real secrets)
MYSQL_DATABASE=incidentiq
MYSQL_USER=incidentiq
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PORT=3308
BACKEND_PORT=8081
FRONTEND_PORT=5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true

# Direct backend run settings only (not used by docker-compose.yml)
DB_URL=jdbc:mysql://localhost:3306/incidentiq?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=incidentiq
DB_PASSWORD=replace-with-a-local-password
